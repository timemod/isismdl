# Directory for module files
MOD_DIR = mod

# create directory 'mod' in a platform independent way using R
$(shell "$(R_HOME)/bin/Rscript" -e "dir.create('$(MOD_DIR)', showWarnings = FALSE)")

# Fortran and C options:
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) 
PKG_FCFLAGS = -fimplicit-none -cpp -Iinclude -J$(MOD_DIR) -I$(MOD_DIR) -Wuninitialized 

all: $(SHLIB)

# dependencies of object files on header files
include makedeps_c.mk

# dependencies of object files files on mod files
include makedeps_f90.mk

# dependencies of object files on include files
mscalc.o : include/mspushf.inc  include/mspushv.inc  include/msshift.inc
